{"html":"import time\nimport requests\n\nTELEGRAM_BOT_TOKEN = \"YOUR_BOT_TOKEN_HERE\"\nTELEGRAM_CHAT_ID = \"YOUR_CHAT_ID_HERE\"\n\ndef send_telegram(msg):\n    url = f\"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage\"\n    payload = {\"chat_id\": TELEGRAM_CHAT_ID, \"text\": msg, \"parse_mode\": \"Markdown\"}\n    try:\n        requests.post(url, json=payload, timeout=10)\n        print(\"✅ تم الإرسال بنجاح\")\n    except Exception as e:\n        print(f\"❌ خطأ: {e}\")\n\ndef run_analysis():\n    print(\"🔄 جاري التحليل...\")\n    url = \"https://query1.finance.yahoo.com/v8/finance/chart/GC=F?interval=15m&range=2d\"\n    headers = {'User-Agent': 'Mozilla/5.0'}\n    \n    try:\n        res = requests.get(url, headers=headers, timeout=10)\n        data = res.json()\n        closes = [c for c in data['chart']['result'][0]['indicators']['quote'][0]['close'] if c is not None]\n        highs = [h for h in data['chart']['result'][0]['indicators']['quote'][0]['high'] if h is not None]\n        lows = [l for l in data['chart']['result'][0]['indicators']['quote'][0]['low'] if l is not None]\n        \n        if not closes:\n            return\n\n        price = round(closes[-1], 2)\n        sma20 = sum(closes[-20:]) / 20\n        sma50 = sum(closes[-50:]) / 50 if len(closes) >= 50 else sma20\n        \n        # حساب RSI بسيط\n        diffs = [closes[i] - closes[i-1] for i in range(1, len(closes))]\n        gains = [d for d in diffs[-14:] if d > 0]\n        losses = [abs(d) for d in diffs[-14:] if d < 0]\n        avg_g = sum(gains)/14 if gains else 0\n        avg_l = sum(losses)/14 if losses else 1\n        rsi = round(100 - (100 / (1 + (avg_g / avg_l))), 2)\n\n        rec_low = round(min(lows[-20:]), 2)\n        rec_high = round(max(highs[-20:]), 2)\n\n        print(f\"السعر: {price} | RSI: {rsi}\")\n\n        # القرارات والسيناريوهات\n        if 43 <= rsi <= 57 and abs(price - sma20) < 1.5:\n            m = f\"⚠️ **تحذير تذبذب**\\nالسعر: `{price}`\\nالنطاق: `{rec_low}` - `{rec_high}`\\nالقرار: انتظار تجنباً للفخاخ.\"\n            send_telegram(m)\n\n        elif price < sma20 and price < sma50 and rsi < 42:\n            sl = round(price + 9.0, 2)\n            tp1 = round(price - 12.0, 2)\n            tp2 = round(price - 20.0, 2)\n            m = f\"📉 **إشارة بيع قوية (XAU/USD)**\\nالدخول: `{price}`\\nوقف الخسارة: `{sl}`\\nالهدف 1: `{tp1}`\\nالهدف 2: `{tp2}`\"\n            send_telegram(m)\n\n        elif rsi < 34 and price <= (rec_low + 3.0):\n            sl = round(rec_low - 5.0, 2)\n            tp = round(price + 10.0, 2)\n            m = f\"⚡ **شراء ارتدادي (مخاطرة)**\\nالدخول: `{price}`\\nوقف الخسارة: `{sl}`\\nالهدف: `{tp}`\"\n            send_telegram(m)\n\n        elif price > sma20 and price > sma50 and rsi > 58:\n            sl = round(price - 9.0, 2)\n            tp = round(price + 12.0, 2)\n            m = f\"📈 **إشارة شراء صريحة**\\nالدخول: `{price}`\\nوقف الخسارة: `{sl}`\\nالهدف: `{tp}`\"\n            send_telegram(m)\n\n    except Exception as e:\n        print(f\"خطأ: {e}\")\n\nif __name__ == \"__main__\":\n    run_analysis()\n","css":"","js":""}